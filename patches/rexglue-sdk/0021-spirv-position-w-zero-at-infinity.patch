+  // A W of exactly 0 makes the Xenos divide X and Y to infinity, and a
+  // rectangle drawn with clipping disabled then covers the whole render target
+  // (Halo: Reach fills the Armory model's alpha with a screen-space rectangle
+  // whose shader fetches the position as xy0_ and exports it as xyzz). The host
+  // clips any primitive with W = 0 instead, so draw such vertices with W = 1
+  // and X and Y far outside the viewport, in the direction of their sign.
+  spv::Id position_w_is_zero =
+      builder_->createBinOp(spv::OpFOrdEqual, type_bool_, position_w, const_float_0_);
+  position_w = builder_->createTriOp(spv::OpSelect, type_float_, position_w_is_zero,
+                                     const_float_1_, position_w);
